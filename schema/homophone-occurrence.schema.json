{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KazumaProject/JapaneseCorpus/blob/main/schema/homophone-occurrence.schema.json",
  "title": "JapaneseCorpus homophone occurrence",
  "type": "object",
  "required": [
    "schema_version",
    "group_id",
    "reading",
    "reading_source",
    "surface",
    "lemma",
    "pos",
    "subpos",
    "subsubpos",
    "source",
    "document_id",
    "title",
    "url",
    "sentence_id",
    "sentence",
    "sentence_start",
    "sentence_end",
    "target_start",
    "target_end",
    "token_index",
    "left_context",
    "right_context"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "group_id": { "type": "string", "minLength": 1 },
    "reading": { "type": "string", "minLength": 1 },
    "reading_source": {
      "enum": ["sudachi", "aozora_ruby"]
    },
    "surface": { "type": "string", "minLength": 1 },
    "lemma": { "type": "string", "minLength": 1 },
    "pos": { "type": "string", "minLength": 1 },
    "subpos": { "type": "string", "minLength": 1 },
    "subsubpos": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "sentence_id": { "type": "string", "minLength": 1 },
    "sentence": { "type": "string", "minLength": 1 },
    "sentence_start": { "type": "integer", "minimum": 0 },
    "sentence_end": { "type": "integer", "minimum": 1 },
    "target_start": { "type": "integer", "minimum": 0 },
    "target_end": { "type": "integer", "minimum": 1 },
    "token_index": { "type": "integer", "minimum": 0 },
    "left_context": { "type": "string" },
    "right_context": { "type": "string" }
  },
  "additionalProperties": false
}
