{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KazumaProject/JapaneseCorpus/blob/main/schema/ngram-annotated-record.schema.json",
  "title": "JapaneseCorpus annotated n-gram record",
  "type": "object",
  "required": [
    "order", "count", "total_observations", "reading", "surface",
    "left_id", "right_id", "cost", "source_tokens", "analysis_scope",
    "morphology", "bunsetsu"
  ],
  "properties": {
    "order": { "type": "integer", "minimum": 1, "maximum": 5 },
    "count": { "type": "integer", "minimum": 1 },
    "total_observations": { "type": "integer", "minimum": 1 },
    "reading": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "left_id": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "right_id": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "cost": { "type": "integer", "minimum": 0, "maximum": 32767 },
    "analysis_scope": { "const": "standalone_phrase" },
    "source_tokens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["surface", "reading", "left_id", "right_id"],
        "properties": {
          "surface": { "type": "string", "minLength": 1 },
          "reading": { "type": "string", "minLength": 1 },
          "left_id": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "right_id": { "type": "integer", "minimum": 0, "maximum": 65535 }
        }
      }
    },
    "morphology": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["surface", "lemma", "pos", "tag", "reading", "start", "end"],
        "properties": {
          "surface": { "type": "string", "minLength": 1 },
          "lemma": { "type": "string" },
          "pos": { "type": "string" },
          "tag": { "type": "string" },
          "reading": { "type": ["string", "null"] },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "bunsetsu": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["surface", "start", "end"],
        "properties": {
          "surface": { "type": "string", "minLength": 1 },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "additionalProperties": false
}
